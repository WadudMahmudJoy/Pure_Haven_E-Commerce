# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Local sensitive/demo runtime data
data/orders.local.json
data/customer-messages.local.json
data/messages.local.json
data/contact-messages.local.json
security-backup-*/
security-backup-step*/
.env.local
.env*.local

# Pure Haven sensitive runtime data
/data/admin-auth.json
/data/customer-users.json
/data/customer-messages.json
/data/orders.json

# Generated Prisma output
/generated/prisma/

# Historical local development backups
/_phase*/


# Keep safe environment template
!.env.example
